FROM registry.redhat.io/rhel10/rhel-bootc:latest@sha256:3eb06c9b7a136e6c30670fab538eee5bfb739d14fd39cdaa1afa60e0a58b7e56

COPY ./bootc/rhel10/etc /etc/
COPY ./bootc/rhel10/usr /usr/
RUN <<EOF
  systemctl disable kdump
  systemctl mask rpm-ostree-countme.timer
  dnf install -y rhc dnf-plugins-core vim zsh tmux systemd-resolved tuned
  dnf clean all
  systemctl enable systemd-resolved.service
  echo 'L /etc/resolv.conf - - - - /run/systemd/resolve/stub-resolv.conf' > /usr/lib/tmpfiles.d/resolv-conf.conf
EOF
