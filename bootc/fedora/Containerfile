FROM quay.io/fedora/fedora-bootc:latest@sha256:1318519ca8eb1f64e6c0d6afb59ac053f1d668f82497799f4af6d54cd115b3b6

COPY ./bootc/fedora/etc /etc/
RUN <<EOF
  systemctl mask rpm-ostree-countme.timer
  update-ca-trust
  dnf -y install dnf5-plugins vim tmux tuned
  dnf clean all
  echo 'L /etc/resolv.conf - - - - /run/systemd/resolve/stub-resolv.conf' > /usr/lib/tmpfiles.d/resolv-conf.conf
EOF
