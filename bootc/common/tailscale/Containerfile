# Installs Tailscale and enables registration service
ARG DISTRO_VER=10

RUN dnf config-manager --add-repo https://pkgs.tailscale.com/stable/rhel/${DISTRO_VER}/tailscale.repo && \
    dnf install -y tailscale && \
    dnf clean all && \
    systemctl enable tailscaled && \
    # systemd-resolved's resolvconf shim makes tailscaled pick openresolv mode and clobber /etc/resolv.conf instead of using its systemd-resolved D-Bus manager
    rm -f /usr/sbin/resolvconf /usr/bin/resolvconf

# Note: this requires Doppler to be installed via the common doppler module
COPY ./bootc/common/tailscale/usr /usr/
RUN systemctl enable tailscale-register.service
