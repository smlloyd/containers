#!/bin/sh
# Registers the node with TS_AUTHKEY from Doppler, only if it has never logged in.
set -eu

# tailscaled reports NoState briefly after starting
state=
for _ in $(seq 30); do
  state=$(tailscale status --json 2>/dev/null | sed -n 's/^ *"BackendState": "\([A-Za-z]*\)".*/\1/p')
  [ -n "$state" ] && [ "$state" != NoState ] && break
  sleep 1
done

if [ "$state" != NeedsLogin ]; then
  echo "Tailscale backend state is ${state:-unknown}; skipping registration"
  exit 0
fi

tailscale up --authkey="$(doppler secrets get TS_AUTHKEY --plain)" --hostname="$1"
